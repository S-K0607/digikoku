---
// ==========================================================================
// トップページ（/）
//
// 初めて訪れた人の疑問に、上から順に答える並びにしています。
//
//   Hero（表紙）
//   01 デジ国について          … これは何？
//   02 話している人            … 誰がやっている？
//   03 Podcast                 … どんな番組？
//   04 発信している場所        … 他にはどこで？
//   05 最新の発信              … 最近は何を出した？
//   06 教育系ポッドキャストの日 … 独立企画は？
//
// カードで囲わず、見出し・本文・日付・罫線・余白だけで並べています。
// 項目が増えても、一覧がそのまま下へ伸びるだけです。
// ==========================================================================

import BaseLayout from "../layouts/BaseLayout.astro";
import EntryRow from "../components/EntryRow.astro";
import Picture from "../components/Picture.astro";
import { site, links, artwork } from "../data/site.js";
import { fetchFeedItems } from "../lib/feeds.js";

// --------------------------------------------------------------------------
// RSSの取得（ビルド時に1回だけ行われます）
//
// PodcastとnoteはRSSから自動取得しています。
// VoicyはRSSが提供されていないため、チャンネルへの案内を手で書いています。
// 取得に失敗した場合は、その媒体のトップページへの案内に切り替わります。
// --------------------------------------------------------------------------
const [podcastFeed, noteFeed] = await Promise.all([
	fetchFeedItems(links.podcastRss.url, 1),
	fetchFeedItems(links.noteRss.url, 1),
]);

const latestPodcast = podcastFeed[0];
const latestNote = noteFeed[0];

// 04「発信している場所」に並べる媒体の一覧。
// 媒体が増えたら、この配列に1件足すだけです。
const channels = [
	{
		type: "Podcast",
		title: "デジタル時代の国語教育を語ろう",
		description: "国語教育とデジタルをめぐって、毎週月曜日に配信しています。",
		url: "/podcast/",
		actionLabel: "聴く",
	},
	{
		type: "Voicy",
		title: "デジタル時代の国語教育ラジオ",
		description: "授業、読書、教育、デジタルについて、毎朝6時半に話しています。",
		url: "/voicy/",
		actionLabel: "聴く",
	},
	{
		type: "note",
		description:
			"授業実践、国語教育、ICT、生成AI、探究について文章で発信しています。",
		url: "/note/",
		actionLabel: "読む",
	},
	{
		type: "教育系ポッドキャストの日",
		description:
			"教育系の番組が同じテーマでそれぞれ配信する共同企画です。主催しています。",
		url: "/podcast-day/",
		actionLabel: "企画を見る",
	},
];

// 05「最新の発信」。Podcast / Voicy / note を同じ形にそろえます。
const latestUpdates = [
	{
		type: "Podcast",
		title: latestPodcast?.title ?? "デジタル時代の国語教育を語ろう",
		date: latestPodcast?.date ?? null,
		description:
			latestPodcast?.description ??
			"毎週月曜配信。最新エピソードは各配信サービスでお聴きいただけます。",
		url: latestPodcast?.url ?? links.podcastSpotify.url,
		actionLabel: "聴く",
	},
	{
		type: "Voicy",
		title: "デジタル時代の国語教育ラジオ",
		date: null,
		description:
			"毎朝6時半に更新しています。日々の授業や読書、教育とデジタルについて考えたことを短く話しています。",
		url: links.voicy.url,
		actionLabel: "聴く",
	},
	{
		type: "note",
		title: latestNote?.title ?? "noteで文章を書いています",
		date: latestNote?.date ?? null,
		description:
			latestNote?.description ??
			"授業実践、国語教育、ICT、生成AI、探究などについて文章で発信しています。",
		url: latestNote?.url ?? links.note.url,
		actionLabel: "読む",
	},
];

// Podcastを聴けるサービス（ボタンではなくテキストリンクで並べます）
const podcastServices = [
	links.podcastSpotify,
	links.podcastApple,
	links.podcastListen,
	links.podcastStandfm,
	links.podcastAmazon,
];

// その他のリンク（SNSなど）
const otherProfiles = [links.x, links.youtube, links.litlink];
---

<BaseLayout>
	{/* ======================================================================
	    Hero — サイトの「表紙」。ここだけ濃紺で、下の紙面と役割を分けています
	   ====================================================================== */}
	<section class="hero deco-grid deco-glow" aria-labelledby="hero-title">
		<div class="container hero__inner">
			<div class="hero__body">
				<h1 class="hero__brand" id="hero-title">{site.name}</h1>
				<p class="hero__en" aria-hidden="true">{site.nameEn}</p>
				<p class="hero__full">{site.subtitle}</p>

				<hr class="rule-accent hero__rule" />

				<p class="hero__lead">
					国語教育、ICT、生成AI、探究、学校について。<br />
					Podcast・Voicy・noteを通して考え、発信しています。
				</p>

				{/* 主要CTAは2つだけ。他の媒体へは下の一覧から辿れます */}
				<div class="button-row hero__links">
					<a class="button button--on-dark" href="/podcast/">Podcastを聴く</a>
					<a class="button button--ghost-on-dark" href="#channels">発信している場所</a>
				</div>
			</div>

			{/* Podcastアートワーク。正方形のまま、トリミングせずに表示します */}
			<div class="hero__artwork">
				<Picture src="/images/podcast-artwork" alt={artwork.alt} eager={true} />
			</div>
		</div>
	</section>

	{/* ======================================================================
	    01 デジ国について — 「これは何？」に答えます
	   ====================================================================== */}
	<section class="section" aria-labelledby="about-digikoku">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">01</span>
				<h2 id="about-digikoku">デジ国について</h2>
			</header>

			<div class="prose">
				<p>
					「デジ国」は、国語教育、ICT、生成AI、探究、学校について考え、
					発信するための場所です。
				</p>
				<p>
					Podcast、Voicy、noteという性格の違う媒体を使いながら、
					授業や研究、読書、日々の学校生活の中で考えていることを言葉にしています。
				</p>
				<p>
					このWebサイトは、それらの発信や企画をまとめる入口です。
				</p>
			</div>
		</div>
	</section>

	{/* ======================================================================
	    02 話している人 — 「誰がやっている？」に答えます
	   ====================================================================== */}
	<section class="section" aria-labelledby="person-title">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">02</span>
				<h2 id="person-title">話している人</h2>
			</header>

			<p class="lead-title">Kasahara Satoru</p>

			<div class="prose">
				<p>
					私立中学・高校の国語科教員。<br />
					Google for Education認定イノベーター／コーチ／トレーナー。
				</p>
				<p>
					国語教育を中心に、ICT、生成AI、探究学習について実践と研究を続けています。
					「教育系ポッドキャストの日」を主催しています。
				</p>
			</div>

			{/* リンクは「何が見られるか」を文で説明してから置きます */}
			<ul class="explained-links">
				<li>
					くわしい経歴と発信の一覧は
					<a class="text-link" href="/about/">プロフィールのページ</a>にあります。
				</li>
				<li>
					論文・発表などの研究業績は
					<a
						class="text-link"
						href={links.researchmap.url}
						target="_blank"
						rel="noopener noreferrer"
					>researchmap</a>にまとめています。
				</li>
				<li>
					Google for Education認定イノベーター／コーチ／トレーナーとしての活動は
					<a
						class="text-link"
						href={links.googleDirectory.url}
						target="_blank"
						rel="noopener noreferrer"
					>Google for Education Directory</a>でご覧いただけます。
				</li>
			</ul>
		</div>
	</section>

	{/* ======================================================================
	    03 Podcast — 「どんな番組？」に答えます
	   ====================================================================== */}
	<section class="section" aria-labelledby="podcast-title">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">03</span>
				<h2 id="podcast-title">Podcast</h2>
			</header>

			<p class="lead-title">デジタル時代の国語教育を語ろう</p>

			<div class="prose">
				<p>
					高校の国語科教員として、授業や国語教育について考えていることを話すPodcastです。
					ICTや生成AI、探究学習、読書、学校で起きていることなど、
					国語教育の周辺にあるテーマも扱います。
				</p>
				<p>
					完成した結論を解説するというより、授業をしたり、本を読んだり、
					誰かと話したりする中で生まれた問いを、そのまま音声で考えていく番組です。
					毎週月曜配信。
				</p>
			</div>

			<div class="link-row block-gap">
				{
					podcastServices.map((service) =>
						service.url ? (
							<a href={service.url} target="_blank" rel="noopener noreferrer">
								{service.label}
							</a>
						) : (
							<span class="is-pending">{service.label}（準備中）</span>
						)
					)
				}
			</div>

			<p class="section-more">
				<a class="text-link" href="/podcast/">エピソード一覧へ</a>
			</p>
		</div>
	</section>

	{/* ======================================================================
	    04 発信している場所 — 「他にはどこで？」に答えます
	   ====================================================================== */}
	<section class="section" id="channels" aria-labelledby="channels-title">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">04</span>
				<h2 id="channels-title">発信している場所</h2>
			</header>

			<div class="entry-list">
				{channels.map((channel) => <EntryRow {...channel} />)}
			</div>

			<h3 class="subheading block-top">その他</h3>
			<div class="link-row">
				{
					otherProfiles.map((item) => (
						<a href={item.url} target="_blank" rel="noopener noreferrer">
							{item.label}
						</a>
					))
				}
			</div>
		</div>
	</section>

	{/* ======================================================================
	    05 最新の発信 — 「最近は何を出した？」に答えます
	   ====================================================================== */}
	<section class="section" aria-labelledby="latest-title">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">05</span>
				<h2 id="latest-title">最新の発信</h2>
			</header>

			<div class="entry-list">
				{latestUpdates.map((entry) => <EntryRow {...entry} />)}
			</div>
		</div>
	</section>

	{/* ======================================================================
	    06 教育系ポッドキャストの日 — 独立した企画
	    ここだけキービジュアルを使いますが、カードでは囲みません
	   ====================================================================== */}
	<section class="section" aria-labelledby="podcast-day-title">
		<div class="container">
			<header class="section-heading">
				<span class="section-number" aria-hidden="true">06</span>
				<h2 id="podcast-day-title">教育系ポッドキャストの日</h2>
			</header>

			<div class="event">
				<div class="event__visual">
					<Picture
						src="/images/podcast-day/kyouikupod3"
						alt="第3回 教育系ポッドキャストの日のキービジュアル。共通テーマ「宿題」、開催期間2026年8月24日（月）〜8月30日（日）。"
					/>
				</div>

				<div class="event__body">
					<p class="event__number">第3回</p>
					<p class="event__theme">共通テーマ「宿題」</p>
					<p class="event__period">2026.8.24 — 8.30</p>

					<p class="event__text">
						学びに関わる番組が、ゆるやかにつながる月1企画。
						教育について話すポッドキャストが、同じ期間に同じテーマで配信します。
						デジ国の番組とは別の、独立したプロジェクトとして主催しています。
					</p>

					<div class="link-row event__links">
						<a href="/podcast-day/">企画について</a>
						<a href="/podcast-day/#join">参加する</a>
						<a href="/podcast-day/#archive">過去の開催</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* ---------------------------------------------------------------- Hero */
	.hero {
		background-color: var(--color-navy);
		background-image: linear-gradient(
			160deg,
			var(--color-navy-deep) 0%,
			var(--color-navy) 45%,
			var(--color-blue) 100%
		);
		color: var(--color-text-on-dark);
		padding-block: var(--space-3xl);
	}

	.hero__inner {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: var(--space-3xl);
		align-items: center;
	}

	/* ブランド名は画像ロゴではなく文字組みで見せています */
	.hero__brand {
		font-size: var(--text-4xl);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #ffffff;
		line-height: 1.1;
	}

	.hero__en {
		font-size: var(--text-xs);
		letter-spacing: 0.3em;
		color: var(--color-teal-light);
		margin-top: var(--space-xs);
	}

	.hero__full {
		font-size: var(--text-xl);
		font-weight: 700;
		color: #ffffff;
		margin-top: var(--space-md);
		line-height: 1.5;
	}

	.hero__rule {
		margin-top: var(--space-lg);
	}

	.hero__lead {
		margin-top: var(--space-lg);
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-on-dark-muted);
		max-width: 32em;
	}

	.hero__links {
		margin-top: var(--space-xl);
	}

	/* アートワーク：正方形を保ち、角丸と影は控えめに。
	   枠線と角丸は外側の <div> に付けます。中の画像は Picture.astro が
	   幅100%で表示し、角丸を border-radius: inherit で引き継ぎます。 */
	.hero__artwork {
		max-width: 460px;
		margin-inline: auto;
		border-radius: var(--radius);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	/* スマートフォン：縦積み（文字 → アートワーク → リンク の順に見えるよう調整） */
	@media (max-width: 860px) {
		.hero {
			padding-block: var(--space-2xl);
		}

		.hero__inner {
			grid-template-columns: 1fr;
			/* 縦積みのときは各要素が自分で余白を持つので、gapは0にします */
			gap: 0;
		}

		/* 左カラムの中身をいったんバラして、アートワークを
		   「紹介文」と「リンク」の間に差し込みます */
		.hero__body {
			display: contents;
		}

		.hero__brand {
			order: 1;
		}
		.hero__en {
			order: 2;
		}
		.hero__full {
			order: 3;
		}
		.hero__rule {
			order: 4;
		}
		.hero__lead {
			order: 5;
		}
		.hero__artwork {
			order: 6;
			margin-top: var(--space-xl);
			max-width: 320px;
		}
		.hero__links {
			order: 7;
		}
	}

	/* ------------------------------------------------------- Hero以下の紙面 */

	/* 一覧の最初の項目にも上罫線を引いて、区切りをそろえます */
	.entry-list {
		border-top: 1px solid var(--color-border);
	}

	/* 番組名・氏名など、見出しの次に強い文字 */
	.lead-title {
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--color-heading);
		margin-bottom: var(--space-md);
	}

	.block-gap {
		margin-bottom: var(--space-xl);
	}

	.block-top {
		margin-top: var(--space-2xl);
	}

	/* 「何が見られるリンクなのか」を文で説明したリンク一覧 */
	.explained-links {
		display: grid;
		gap: var(--space-sm);
		max-width: var(--width-narrow);
		margin-top: var(--space-xl);
		line-height: var(--leading-normal);
	}

	.section-more {
		margin-top: var(--space-lg);
	}

	/* -------------------------------------------- 教育系ポッドキャストの日 */
	/* 画像と本文が並ぶだけの構成。カードでは囲みません */
	.event {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: var(--space-2xl);
		align-items: start;
	}

	.event__visual {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.event__number {
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}

	.event__theme {
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--color-heading);
		margin-top: var(--space-2xs);
	}

	.event__period {
		margin-top: var(--space-xs);
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.event__text {
		margin-top: var(--space-md);
		max-width: var(--width-narrow);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
	}

	.event__links {
		margin-top: var(--space-lg);
	}

	@media (max-width: 720px) {
		.event {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}

		.event__visual {
			max-width: 320px;
		}
	}
</style>
