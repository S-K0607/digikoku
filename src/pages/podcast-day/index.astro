---
// ==========================================================================
// 教育系ポッドキャストの日（/podcast-day/）
//
// デジ国の各媒体とは別の、独立した企画のページです。
// 今は1ページに「企画概要 / 最新回 / 参加する / 過去の開催」を並べています。
//
// 【将来 開催回をデータとして管理するときに変えるのはこのファイル周辺】
// 開催回が増えてきたら、次のように育てる想定です。
//   src/pages/podcast-day/index.astro        … このページ（一覧・概要）
//   src/pages/podcast-day/[slug].astro       … 各開催回の個別ページ
//   src/content/events/                      … 開催回のデータ（必要になったら）
// 今の段階では、下の editions 配列に1件足すだけで一覧が増えます。
// ==========================================================================

import BaseLayout from "../../layouts/BaseLayout.astro";
import Picture from "../../components/Picture.astro";
import { site, links } from "../../data/site.js";

const title = `教育系ポッドキャストの日｜${site.name}`;
const description =
	"教育について話すポッドキャストが、同じ期間に同じテーマで配信する企画「教育系ポッドキャストの日」の案内。";

// --- 次回の開催回 ----------------------------------------------------------
//
// keyVisual は「拡張子を除いた」画像パスを書きます。
// public/images/podcast-day/ に .webp と .png の両方を置いてください。
// （元の大きな画像は assets/podcast-day-original/ に保管してあります）
const latestEdition = {
	number: "第3回",
	name: "教育系ポッドキャストの日",
	theme: "「宿題」",
	period: "2026年8月24日（月）〜 8月30日（日）",
	summary:
		"8月下旬といえば、やっぱり「宿題」。子どもの頃に泣かされっぱなしだった思い出話はもちろん、大人になった今、自分へ課して楽しんでいる探究やこだわりについても広く募集します。",
	keyVisual: "/images/podcast-day/kyouikupod3",
	keyVisualAlt:
		"第3回 教育系ポッドキャストの日のキービジュアル。共通テーマ「宿題」、開催期間2026年8月24日（月）〜8月30日（日）。",
	playlist: null, // 開催後にプレイリストのURLを入れてください
};

// --- 過去の開催 ------------------------------------------------------------
// 開催回が増えたら、この配列の先頭に1件足してください。
const pastEditions = [
	{
		number: "第2回",
		theme: "「私の自由研究」",
		period: "2026年7月20日（月）〜 7月26日（日）",
		keyVisual: "/images/podcast-day/kyouikupod2",
		keyVisualAlt:
			"第2回 教育系ポッドキャストの日のキービジュアル。共通テーマ「私の自由研究」、開催期間2026年7月20日（月）〜7月26日（日）。",
		playlist: "https://open.spotify.com/playlist/0f8wIzYL1zSFF6VmLVe5iD",
	},
	{
		number: "第1回",
		theme: "「はじめての学び」",
		period: "2026年6月15日（月）〜 6月21日（日）",
		keyVisual: "/images/podcast-day/kyouikupod1",
		keyVisualAlt:
			"第1回 教育系ポッドキャストの日のキービジュアル。共通テーマ「はじめての学び」、開催期間2026年6月15日（月）〜6月21日（日）。",
		playlist: "https://open.spotify.com/playlist/5S2HXflqEQg5q9KIWMTbS5",
	},
];
---

<BaseLayout title={title} description={description}>
	<div class="page-hero deco-grid deco-glow">
		<div class="container">
			<a class="page-hero__back" href="/">← デジ国トップへ</a>
			<h1>教育系ポッドキャストの日</h1>
			<p class="page-hero__lead">
				学びに関わる番組が、ゆるやかにつながる月1企画。
			</p>
		</div>
	</div>

	{/* --- 企画について --- */}
	<section class="section" aria-labelledby="about-project">
		<div class="container">
			<header class="section-heading">
				<h2 id="about-project">企画について</h2>
			</header>

			<div class="prose">
				<p>
					「教育系ポッドキャストの日」は、教育をテーマに発信しているポッドキャスト番組が、
					あらかじめ決めた期間に、共通のテーマで配信する企画です。
				</p>
				<p>
					番組ごとに立場も校種も専門も違います。同じテーマでも、話されることは番組ごとに大きく違います。
					その違いをまとめて聴けることが、この企画のいちばんの面白さです。
				</p>
				<p>
					デジ国の番組「デジタル時代の国語教育を語ろう」も参加していますが、
					この企画自体はデジ国のものではなく、参加するみんなの企画です。
				</p>
			</div>
		</div>
	</section>

	{/* --- 次回開催 --- */}
	<section class="section" aria-labelledby="latest-edition">
		<div class="container">
			<header class="section-heading">
				<h2 id="latest-edition">次回開催</h2>
			</header>

			<article class="edition">
				{/* 各開催回のキービジュアル。回ごとに違う画像を設定できます */}
				<div class="edition__visual">
					{
						latestEdition.keyVisual ? (
							<Picture src={latestEdition.keyVisual} alt={latestEdition.keyVisualAlt} />
						) : (
							<div
								class="visual-placeholder"
								role="img"
								aria-label="開催回のキービジュアル（未設定）"
							>
								<span>キービジュアル未設定</span>
							</div>
						)
					}
				</div>

				<div class="edition__body">
					<h3 class="edition__number">{latestEdition.number}</h3>
					<p class="edition__theme">共通テーマ{latestEdition.theme}</p>
					<p class="edition__period">{latestEdition.period}</p>

					<p class="edition__text">{latestEdition.summary}</p>

					<div class="link-row edition__links">
						<a href="#join">参加する</a>
						<a href="#archive">過去の開催</a>
					</div>
				</div>
			</article>
		</div>
	</section>

	{/* --- 参加する --- */}
	<section class="section" id="join" aria-labelledby="join-title">
		<div class="container">
			<header class="section-heading">
				<h2 id="join-title">参加する</h2>
			</header>

			<div class="prose">
				<div class="speech-bubble join-bubble">
					<p>
						教育について話しているポッドキャストであれば、番組の大きさや配信歴に関わらず参加できます。
					</p>
				</div>

				<h3 class="subheading join-steps__heading">参加方法はカンタン！</h3>
				<ol class="join-steps">
					<li>Xで番組名と一緒に参加表明をポスト</li>
					<li>
						ハッシュタグ <strong>#教育系ポッドキャストの日</strong> をつけて投稿
					</li>
					<li>Podcast / Voicy / どんな配信スタイルでもOK</li>
				</ol>

				<p class="join-note">
					開催期間中に、共通テーマに沿った回を配信していただくだけです。
					5分のミニトークから雑談、対談まで大歓迎。
				</p>
			</div>

			<div class="link-row join-links">
				<a href={links.x.url} target="_blank" rel="noopener noreferrer">
					Xで主催者に連絡する
				</a>
			</div>
		</div>
	</section>

	{/* --- 過去の開催 --- */}
	<section class="section" id="archive" aria-labelledby="archive-title">
		<div class="container">
			<header class="section-heading">
				<h2 id="archive-title">過去の開催</h2>
			</header>

			<p class="section-lead">
				過去回の配信は、各回のプレイリストからまとめて聴けます。
			</p>

			{/* 開催回が増えても、この一覧が下へ伸びるだけです */}
			<div class="edition-list">
				{
					pastEditions.map((edition) => (
						<article class="edition">
							<div class="edition__visual">
								{edition.keyVisual ? (
									<Picture src={edition.keyVisual} alt={edition.keyVisualAlt} />
								) : (
									<div class="visual-placeholder" aria-hidden="true">
										<span>キービジュアル未設定</span>
									</div>
								)}
							</div>

							<div class="edition__body">
								<h3 class="edition__number">{edition.number}</h3>
								<p class="edition__theme">共通テーマ{edition.theme}</p>
								<p class="edition__period">{edition.period}</p>

								{edition.playlist && (
									<p class="edition__links">
										<a
											class="text-link"
											href={edition.playlist}
											target="_blank"
											rel="noopener noreferrer"
										>
											この回のプレイリストを聴く（Spotify）
										</a>
									</p>
								)}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* --------------------------------------------------------------------
	   開催回のレイアウト
	   画像と本文が並ぶだけの構成です。カードでは囲みません。
	   次回開催・過去の開催の両方で同じ形を使っています。
	   -------------------------------------------------------------------- */
	.edition {
		display: grid;
		grid-template-columns: 300px 1fr;
		gap: var(--space-2xl);
		align-items: start;
	}

	/* 過去の開催は、1件ずつ罫線で区切って縦に積みます */
	.edition-list {
		border-top: 1px solid var(--color-border);
	}

	.edition-list .edition {
		padding-block: var(--space-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.edition__visual {
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.edition__number {
		font-size: var(--text-lg);
	}

	.edition__theme {
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--color-heading);
		margin-top: var(--space-2xs);
	}

	.edition__period {
		margin-top: var(--space-xs);
		color: var(--color-text-muted);
	}

	.edition__text {
		margin-top: var(--space-md);
		max-width: var(--width-narrow);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
	}

	.edition__links {
		margin-top: var(--space-lg);
	}

	/* 画像が未設定のときの枠 */
	.visual-placeholder {
		aspect-ratio: 1 / 1;
		display: grid;
		place-items: center;
		border-radius: var(--radius);
		background-color: #f0eee7;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-align: center;
		line-height: 1.8;
	}

	/* --- 参加する --- */
	.join-bubble {
		margin-bottom: var(--space-xl);
	}

	.join-steps__heading {
		margin-top: var(--space-xl);
	}

	/* 番号付きの手順。丸い番号はCSSで作っています */
	.join-steps {
		counter-reset: step;
		display: grid;
		gap: var(--space-sm);
		margin-bottom: var(--space-lg);
	}

	.join-steps li {
		counter-increment: step;
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
		font-size: var(--text-sm);
	}

	.join-steps li::before {
		content: counter(step);
		flex: 0 0 auto;
		width: 1.6em;
		height: 1.6em;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background-color: var(--color-teal);
		color: #ffffff;
		font-size: var(--text-xs);
		font-weight: 700;
	}

	.join-note {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.join-links {
		margin-top: var(--space-xl);
	}

	@media (max-width: 720px) {
		.edition {
			grid-template-columns: 1fr;
			gap: var(--space-lg);
		}

		.edition__visual {
			max-width: 300px;
		}
	}
</style>
