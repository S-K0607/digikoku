---
// ==========================================================================
// EntryRow.astro
// 「1件の発信」を、カードではなく“紙面の1行”として表示する部品。
//
//   PODCAST                              2026.08.16
//   #108 先生こそポッドキャストを始めてほしい
//   第108回配信。夏休み前半は……
//                                            聴く →
//   ────────────────────────────────────────────
//
// 箱で囲わず、1件ごとに細い罫線で区切ります。
// Podcast / Voicy / note を同じ部品で表示できます。
//
// 受け取る値（props）:
//   type        … 媒体名・区分（例: "Podcast"）。小さく表示します
//   title       … タイトルや番組名。この行の主役。省略可
//   date        … 公開日 "2026-08-16" 形式。省略可
//   description … 短い説明や抜粋。省略可
//   url         … リンク先。null なら「準備中」と表示します
//   actionLabel … リンクの文言（省略時は「開く」）
//   tentative   … true なら「仮」と添える（内容がまだ仮のとき）
//
// 「最新の発信」と「発信している場所」の両方をこの部品で表示しています。
// 項目が何件に増えても、そのまま下へ伸びるだけです。
// ==========================================================================

import { formatDate } from "../lib/feeds.js";

const {
	type,
	title = null,
	date = null,
	description = null,
	url = null,
	actionLabel = "開く",
	tentative = false,
} = Astro.props;

const displayDate = formatDate(date);

// サイト内のリンクは同じタブで、外部サイトは新しいタブで開きます
const isExternal = typeof url === "string" && url.startsWith("http");
---

<article class="entry">
	<div class="entry__meta">
		<span class="entry__type">
			{type}
			{tentative && <span class="entry__tentative">（仮）</span>}
		</span>
		{
			displayDate && (
				<time class="entry__date" datetime={date}>
					{displayDate}
				</time>
			)
		}
	</div>

	{title && <h3 class="entry__title">{title}</h3>}

	{description && <p class="entry__text">{description}</p>}

	<p class="entry__action">
		{
			url ? (
				<a
					class="entry__link"
					href={url}
					target={isExternal ? "_blank" : undefined}
					rel={isExternal ? "noopener noreferrer" : undefined}
				>
					{actionLabel}
					{/* 「聴く」だけでは何を聴くのか分からないため、
					     読み上げ用に対象の名前を添えています（画面には出ません） */}
					<span class="visually-hidden">（{title ?? type}）</span>
				</a>
			) : (
				<span class="entry__pending">準備中</span>
			)
		}
	</p>
</article>

<style>
	/* 罫線は「囲む」のではなく「区切る」ために使います。
	   この行はどこをクリックしても、リンク先へ移動できます（下の .entry__link 参照） */
	.entry {
		position: relative;
		padding-block: var(--space-xl);
		border-bottom: 1px solid var(--color-border);
		transition: background-color 0.15s ease;
	}

	/* クリックできることが分かるように、重ねたときだけ薄く色を敷きます */
	.entry:hover {
		background-color: #f2f0e9;
	}

	/* キーボードで選んだときは、行全体を囲んで位置を示します */
	.entry:focus-within {
		outline: 3px solid var(--color-yellow);
		outline-offset: 2px;
		border-radius: var(--radius);
	}

	.entry__meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-xs) var(--space-lg);
		margin-bottom: var(--space-sm);
	}

	/* 媒体名は色ではなく文字で示します（媒体ごとの色分けはしません） */
	.entry__type {
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--color-text-muted);
		text-transform: uppercase;
	}

	.entry__tentative {
		letter-spacing: normal;
		color: var(--color-orange-dark);
	}

	.entry__date {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	/* タイトルがこの行の主役 */
	.entry__title {
		font-size: var(--text-xl);
		line-height: 1.5;
	}

	.entry__text {
		margin-top: var(--space-sm);
		max-width: var(--width-narrow);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
	}

	/* リンクは右端に。小さすぎると押しづらいので、本文と同じ大きさにしています */
	.entry__action {
		margin-top: var(--space-md);
		text-align: right;
	}

	/* このリンクは「行全体」に広がります。
	   ::after を行いっぱいに重ねることで、どこを押しても反応します。
	   （文字だけを押させるより、はるかに押しやすくなります） */
	.entry__link {
		display: inline-block;
		font-size: var(--text-base);
		font-weight: 700;
		color: var(--color-link);
		text-decoration: none;
		padding: var(--space-2xs) 0;
		border-bottom: 2px solid var(--color-teal);
	}

	.entry__link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.entry:hover .entry__link {
		color: var(--color-link-hover);
		border-bottom-color: var(--color-yellow);
	}

	/* 行のどこを押しても飛べるので、タイトルも一緒に反応させます */
	.entry:hover .entry__title {
		color: var(--color-link);
	}

	/* 行全体に枠が出るので、リンク自体の枠は消します */
	.entry__link:focus-visible {
		outline: none;
	}

	.entry__pending {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.entry {
			padding-block: var(--space-lg);
		}

		/* 狭い画面では、媒体名・日付・リンクが自然に縦へ並びます */
		.entry__meta {
			flex-direction: column;
		}

		.entry__action {
			text-align: left;
		}
	}
</style>
